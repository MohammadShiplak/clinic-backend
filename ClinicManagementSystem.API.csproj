    <UserSecretsId>b048acaf-0e50-4df5-bc3f-3ea6816b6250</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="NewFolder1\**" />
    <Compile Remove="NewFolder2\**" />
