{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "Appointments": {

        "WorkdayStart": "09:00",
        "WorkdayEnd": "17:00",
        "SlotMinutes": 30,
        "TimeZoneId": "Asia/Amman"

    },
    "Reminders": {
        "LeadTimeHours": 24,
        "CheckIntervalMinutes": 5
    },

    "Email": {
        "Provider": "Log",
        "Host": "",
        "Port": 587,
        "Username": "",
        "FromAddress": "no-reply@clinic.example",
        "FromName": "Clinic",
        "DispatchIntervalSeconds": 30,
        "MaxAttempts": 5
    },

    "Jwt": {
        "Issuer": "ClinicManagementSystem.API",
        "Audience": "ClinicManagementSystem.Client",
        "AccessTokenMinutes": 30
    },


    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/clinic-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 14,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [ "FromLogContext" ]
    }


}
