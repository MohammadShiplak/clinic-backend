{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "Appointments": {

        "WorkdayStart": "09:00",
        "WorkdayEnd": "17:00",
        "SlotMinutes": 30,
        "TimeZoneId": "Asia/Amman"

    },
    "Reminders": {
        "LeadTimeHours": 24,
        "CheckIntervalMinutes": 5
    },

    "Email": {
        "Provider": "Log",
        "Host": "",
        "Port": 587,
        "Username": "",
        "FromAddress": "no-reply@clinic.example",
        "FromName": "Clinic",
        "DispatchIntervalSeconds": 30,
        "MaxAttempts": 5
    },

    "Jwt": {
        "Issuer": "ClinicManagementSystem.API",
        "Audience": "ClinicManagementSystem.Client",
        "AccessTokenMinutes": 30
    },


    "RateLimiting": {
        "Global": {
            "PermitLimit": 100,
            "WindowSeconds": 60
        },
        "Auth": {
            "PermitLimit": 5,
            "WindowSeconds": 60
        },
        "Booking": {
            "PermitLimit": 10,
            "WindowSeconds": 60
        }
    }



}
